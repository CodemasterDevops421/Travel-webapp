<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LiteAPI Booking</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <h1>Book Your Stay</h1>
    <p>Choose destination search or search by vibe.</p>

    <form id="searchForm" class="card">
      <div class="row">
        <label><input type="radio" name="mode" value="destination" checked> Search by destination</label>
        <label><input type="radio" name="mode" value="vibe"> Search by vibe</label>
      </div>

      <div id="destinationFields">
        <label>Destination</label>
        <input id="placeInput" type="text" placeholder="City, country..." autocomplete="off">
        <input id="placeId" type="hidden">
        <ul id="placeResults" class="suggestions"></ul>
      </div>

      <div id="vibeFields" class="hidden">
        <label>Vibe query</label>
        <input id="vibeInput" type="text" placeholder="romantic getaway in paris">
      </div>

      <div class="row">
        <div>
          <label>Check-in</label>
          <input id="checkin" type="date" required>
        </div>
        <div>
          <label>Check-out</label>
          <input id="checkout" type="date" required>
        </div>
        <div>
          <label>Guests</label>
          <input id="guests" type="number" min="1" max="8" value="2" required>
        </div>
      </div>
      <button type="submit">Search Hotels</button>
    </form>

    <div id="results" class="grid"></div>
    <p class="note">Sandbox payment test card: 4242 4242 4242 4242, any 3-digit CVV, any future expiry.</p>
  </main>

  <script>
    window.APP_CONFIG = { apiEnv: '<%= apiEnv %>' };
  </script>
  <script src="/app.js"></script>
</body>
</html>
