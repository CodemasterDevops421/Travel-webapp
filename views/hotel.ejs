<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= hotel.name %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container">
    <a href="/">← Back to search</a>
    <h1><%= hotel.name %></h1>
    <p><%= hotel.address %>, <%= hotel.city %>, <%= hotel.country %></p>
    <% if (hotel.main_photo) { %><img class="hero" src="<%= hotel.main_photo %>" alt="<%= hotel.name %>"><% } %>

    <section>
      <h2>Available Offers by Room</h2>
      <% roomGroups.forEach((room) => { %>
        <article class="card room-card">
          <div class="room-header">
            <img src="<%= room.roomImage %>" alt="<%= room.roomName %>">
            <div>
              <h3><%= room.roomName %></h3>
              <small>Room ID: <%= room.mappedRoomId %></small>
            </div>
          </div>

          <% room.offers.forEach((offer) => { %>
            <% offer.rates.forEach((rate) => { %>
              <form action="/checkout/start" method="POST" class="offer-row">
                <div>
                  <strong><%= rate.name %></strong>
                  <div><%= rate.boardName %> · <%= rate.refundableTag %> · <%= rate.taxesIncluded ? 'Taxes included' : 'Taxes may apply' %></div>
                  <% if (rate.cancelTime) { %><small>Free cancellation until: <%= rate.cancelTime %></small><% } %>
                </div>
                <div class="price">$<%= rate.amount %> <%= rate.currency %></div>
                <input type="hidden" name="offerId" value="<%= offer.offerId %>">
                <input type="hidden" name="hotelId" value="<%= hotel.id %>">
                <input type="hidden" name="checkin" value="<%= query.checkin %>">
                <input type="hidden" name="checkout" value="<%= query.checkout %>">
                <input type="hidden" name="guests" value="<%= query.guests %>">
                <button type="submit">Select Offer</button>
              </form>
            <% }) %>
          <% }) %>
        </article>
      <% }) %>
    </section>
  </main>
</body>
</html>
