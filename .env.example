NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LITEAPI_ENV=sandbox

# LiteAPI (preferred key name)
LITEAPI_API_KEY=your_liteapi_api_key
# Legacy compatibility for server.js path (optional; keep same value if used)
LITEAPI_KEY=your_liteapi_api_key
LITEAPI_ENV=sandbox
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_BOOK_BASE_URL=https://book.liteapi.travel/v3.0
LITEAPI_TIMEOUT_MS=8000
QUOTE_SIGNING_SECRET=replace_with_min_16_char_secret
BOOKING_VIEW_TOKEN_SECRET=replace_with_min_16_char_secret
BOOKING_API_AUTH_SECRET=replace_with_min_24_char_secret_for_internal_booking_api
BOOKING_VIEW_TOKEN_TTL_SECONDS=600
DEFAULT_GUEST_NATIONALITY=US

GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional Prisma / Neon
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Optional Upstash cache/ratelimit
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
STRICT_PERSISTENCE_MODE=false

# Optional Stripe/LiteAPI webhook flow
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
LITEAPI_WEBHOOK_SECRET=liteapi_webhook_secret_xxx

# Server session secret (legacy express flow)
SESSION_SECRET=replace_with_random_long_secret

SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

PRICE_MARKUP_PERCENT=12
DEFAULT_CURRENCY=USD
LOG_LEVEL=info
